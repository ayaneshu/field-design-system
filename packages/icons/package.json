{
  "name": "@field-ds/icons",
  "version": "0.0.0",
  "description": "M-Icon library — SVGs synced from Figma + React Native components.",
  "license": "MIT",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./Icon": "./src/Icon.tsx",
    "./svg/*": "./src/svg/*"
  },
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "fetch": "tsx scripts/fetch-from-figma.ts",
    "build": "tsx scripts/svg-to-rn.ts",
    "build:lib": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@types/react": "~18.2.45",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-svg": "15.2.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
